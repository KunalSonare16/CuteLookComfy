# Database
# Local dev:  jdbc:postgresql://localhost:5432/ecommerce
# Supabase:   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=postgres
DB_PASSWORD=strongpassword123

# Redis
REDIS_PASSWORD=

# JWT - Generate with: openssl rand -base64 64
JWT_SECRET=bXlzdXBlcnNlY3JldGtleW15c3VwZXJzZWNyZXRrZXkxMjM0NTY=

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL (for CORS + OAuth2 redirect)
FRONTEND_URL=http://localhost:3000

# Email (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Supabase Storage (product/profile images).
# Leave SUPABASE_URL blank in local dev to use the ./uploads folder instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-images

# React (frontend build-time vars)
# In production set REACT_APP_API_URL to your deployed backend URL, e.g. https://cutelookcomfy-api.onrender.com
REACT_APP_API_URL=http://localhost:8080
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_key_id
